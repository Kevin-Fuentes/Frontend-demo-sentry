# Copy this file to .env.local and fill in your real Sentry DSN.
# Get a DSN by creating a project at https://sentry.io (Platform: Next.js).

# Used by both the browser and server SDK init calls.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional: only needed if you want source maps uploaded on `next build`.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
